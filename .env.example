# Copy to .env and fill in. Never commit .env.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (required by the spec). Set DB_ENGINE=sqlite only for a quick local run.
DB_ENGINE=postgresql
DB_NAME=enterprise_auth
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Frontend origin (CORS + links in activation/reset emails)
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1
# Set to False only for local http development
REFRESH_COOKIE_SECURE=True

# Email (console backend prints emails to the server terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@enterprise-auth.local

# Rate limits
THROTTLE_LOGIN=5/min
THROTTLE_REGISTER=10/hour
THROTTLE_PASSWORD_RESET=5/hour

# Password for the demo users created by `python manage.py seed_data --demo`
DEMO_PASSWORD=change-me
